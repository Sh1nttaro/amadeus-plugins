# Third-party Live2D / 3D models (large, separate licenses) — put them into companion/models locally
amadeus-live2d/companion/models/
amadeus-live3d/companion/models/

# Per-user companion settings
**/companion/settings.json

# Whether the GPU can draw the Live2D model on this computer
**/companion/gpu.json

# Local backups and debug artifacts
**/_backup/
*.orig-bak
*.bak-bubble
_live_dsh.png

node_modules/
*.log

# User content of the 3D companion
amadeus-live3d/companion/animations/

# Per-user DSH chat binding (workspace / session ids)
**/companion/chat.json

# What the providers plugin learned from endpoints
amadeus-providers/data.json

# Per-user harness settings and sessions
amadeus-harness/data/
